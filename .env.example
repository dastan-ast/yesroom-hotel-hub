# ══════════════════════════════════════════
# YesRoom Self-Hosted Configuration
# Скопируйте в .env и заполните значения
# ══════════════════════════════════════════

# ── Обязательные секреты ──
POSTGRES_PASSWORD=your-super-secret-password-change-me
JWT_SECRET=your-jwt-secret-at-least-32-characters-long-change-me
SECRET_KEY_BASE=your-secret-key-base-at-least-64-characters-long-change-me

# Сгенерируйте через: https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# ── Домен ──
SITE_URL=https://yesroom.yourdomain.com
API_EXTERNAL_URL=https://api.yesroom.yourdomain.com
SUPABASE_PUBLIC_URL=https://api.yesroom.yourdomain.com

# ── Порты (по умолчанию) ──
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3000
REDIS_PORT=6379

# ── Redis ──
REDIS_PASSWORD=yesroom-redis-pass-change-me

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ADMIN_EMAIL=admin@yesroom.app
SMTP_SENDER_NAME=YesRoom

# ── Опционально ──
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
JWT_EXPIRY=3600
ADDITIONAL_REDIRECT_URLS=
